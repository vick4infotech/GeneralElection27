# Configure in Dokploy secrets, NOT in the repository
NEXT_PUBLIC_SITE_URL=https://generalelection2027.com
DATABASE_URL=postgresql://YOUR_USER:YOUR_PASSWORD@YOUR_POSTGRES_HOST:5432/YOUR_DB
DATABASE_SSL=false
# Random 32+ character independent secrets (run: openssl rand -hex 32)
AUTH_SECRET=replace-this-with-a-cryptographically-random-64-character-secret
POLL_HASH_SECRET=replace-this-with-a-different-cryptographically-random-64-character-secret
# Brevo SMTP: SMTP_PASS must be a Brevo SMTP key (xsmtpsib-...), NOT its v3 HTTP API key.
# Never commit a real SMTP password or include it in your ZIP.
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=c04355001@smtp-brevo.com
SMTP_PASS=PASTE_NEW_ROTATED_SMTP_KEY_IN_DOKPLOY_ONLY
SMTP_FROM="General Election 2027 <no-reply@YOUR_VERIFIED_DOMAIN>"


# Meta for Developers > Facebook Login > Settings
# App remains disabled until real credentials and allowed callback URL are set.
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
FACEBOOK_GRAPH_VERSION=v24.0
FACEBOOK_REDIRECT_URI=https://generalelection2027.com/api/auth/facebook/callback
# SMTP is REQUIRED for community poll responses. Guest games remain free without SMTP.
