# Copy these keys into Dokploy > Application > Environment.
# Never commit real DATABASE_URL, SMTP_PASS, AUTH_SECRET, POLL_HASH_SECRET.
NODE_ENV=production
PORT=3000
NEXT_PUBLIC_SITE_URL=https://generalelection2027.com
DATABASE_URL=postgresql://YOUR_USER:YOUR_PASSWORD@YOUR_DOKPLOY_PG_HOST:5432/gen2027
DATABASE_SSL=false
AUTH_SECRET=YOUR_EXISTING_STABLE_SERVER_SECRET
POLL_HASH_SECRET=YOUR_EXISTING_STABLE_POLL_HASH_SECRET
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=YOUR_BREVO_SMTP_LOGIN
SMTP_PASS=YOUR_BREVO_SMTP_KEY
SMTP_FROM="Hicroft Technology <YOUR_VERIFIED_BREVO_SENDER>"
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
FACEBOOK_GRAPH_VERSION=v24.0
FACEBOOK_REDIRECT_URI=https://generalelection2027.com/api/auth/facebook/callback
